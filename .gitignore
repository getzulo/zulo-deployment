# Secrets — real values never belong in the repo; only .env.example is tracked.
.env
.env.*
!.env.example
*.local.json

# TLS material. prod/certs/ holds the Cloudflare Origin CA key, which is shown
# exactly once at issuance and is a full origin-impersonation credential.
certs/
*.key
*.pem
*.pfx
*.p12

# Runtime state
logs/
volumes/
acme.json
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Generated configs
.generated/
*.rendered

# OS
.DS_Store
Thumbs.db
