# Phase 0 configuration. Copy to `.env` and fill in.
#   cp .env.example .env
#
# Generate the secrets (any of these):
#   openssl rand -base64 36
#   pwsh -c "[Convert]::ToBase64String((1..36|%{Get-Random -Max 256}))"
#
# NOTE: POSTGRES_PASSWORD and T1_DB_PASSWORD are consumed only when the Postgres
# data volume is FIRST created. Changing them later does not re-run the bootstrap
# — drop the volume (`docker compose down -v`) or ALTER the role by hand.

# --- required -------------------------------------------------------------
# Superuser password for the Postgres cluster.
POSTGRES_PASSWORD=

# Password for the tenant_t1 role that owns the tenant_t1 database.
T1_DB_PASSWORD=

# Per-tenant JWT signing key. Distinct per tenant, so a token minted for one is
# meaningless to another.
T1_JWT_KEY=

# --- optional -------------------------------------------------------------
# Tenant image tag. Build it from the zulo.one repo:
#   docker build -f src/ZuloOne.Core/Dockerfile -t zuloone/core:dev .
ZULOONE_IMAGE=zuloone/core:dev

# Hostname the tenant answers on. The default resolves to 127.0.0.1 in browsers
# with no DNS setup at all, which is what makes local Phase 0 runs work.
T1_HOST=t1.localhost

# Host port for Traefik's dashboard (loopback only). Change it if the default is
# taken — on Windows 8080 is commonly reserved and cannot be bound at all.
TRAEFIK_DASHBOARD_PORT=8090

# --- required ONLY for the TLS overlay (docker-compose.tls.yml) ------------
# ACME_EMAIL=admin@example.com
# ACME_DOMAIN=example.com
# ACME_DNS_PROVIDER=cloudflare
# CF_DNS_API_TOKEN=
