# Copy to /opt/zuloone/login.env on zo-app-1, mode 0600. Never commit the filled copy.
# Compose overlays public URLs and client ids from docker-compose.accounts.yml;
# this file is only the secrets and the Turnstile pair.

ConnectionStrings__Login=

Oauth__Clients__0__ClientSecret=
Oauth__Clients__1__ClientSecret=
# Same value as Directory__ClientSecret in zo-cp-1 /opt/zuloone/cp.env
Oauth__Clients__2__ClientSecret=

# Cloudflare Dashboard → Turnstile → widget for hostname login.getzulo.com, Managed.
# Production refuses every password post until both are set.
Turnstile__SiteKey=
Turnstile__Secret=

Telegram__BotToken=
Telegram__BotUsername=
Telegram__WebhookSecret=
