# Production configuration. Copy to `.env` and fill in.
#   cp .env.example .env && chmod 600 .env
#
# Generate secrets with:  openssl rand -base64 36

# --- image ----------------------------------------------------------------
# Built by zulo.one's CI on zo-ci-1 and pushed to the registry there.
# zo-app-1 needs 10.10.0.210:5000 in /etc/docker/daemon.json insecure-registries,
# since the registry speaks plain HTTP on the private subnet.
# Pin an immutable version; never `latest` — two tenants "on the same version"
# running different code is the failure this avoids.
ZULOONE_IMAGE=10.10.0.210:5000/zuloone-core:2026.9.0

# --- routing --------------------------------------------------------------
# Must match a hostname covered by the Cloudflare Origin certificate
# (`*.zulo.one`) and resolve through the proxied wildcard DNS record.
T1_HOST=t1.zulo.one

# Traefik dashboard, bound to loopback. Reach it over an SSH tunnel:
#   ssh -L 8090:127.0.0.1:8090 deploy@<host>
TRAEFIK_DASHBOARD_PORT=8090

# --- Postgres cluster -----------------------------------------------------
# BOTH nodes, comma-separated. They are in different subnets on purpose: different
# subnets mean different ESXi hosts, so the standby survives losing the primary's
# hardware. See ARCHITECTURE.md §1.
# Npgsql picks whichever is currently primary and
# re-checks every 10 s, so this survives a Patroni failover untouched.
# Order does not imply preference — `Target Session Attributes=Primary` decides.
PG_HOSTS=10.10.1.210,10.10.2.210
PG_PORT=5432

# Require | Disable — check first, on the primary:  psql -c "SHOW ssl;"
# Do NOT use Prefer: it falls back to plaintext silently, so you never learn
# whether the connection was actually encrypted.
PG_SSL_MODE=Require

T1_DB_NAME=tenant_t1
T1_DB_USER=tenant_t1
T1_DB_PASSWORD=

# --- secrets --------------------------------------------------------------
# Per-tenant JWT signing key. HS256 needs >= 32 bytes of entropy.
# If this is left empty Core generates a random key into zuloone.local.json
# inside the container — which a rebuild throws away, logging every user out.
T1_JWT_KEY=
